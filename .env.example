# mock mode needs no keys. fixture/rag/web use OPENAI_API_KEY.
OPENAI_API_KEY=
TAVILY_API_KEY=

# Enable only when sending your node inputs/outputs to your LangSmith workspace.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=kv-rag-yourname-dev
# Set these only when required by your workspace/region:
# LANGSMITH_WORKSPACE_ID=
# LANGSMITH_ENDPOINT=

# Optional per-machine overrides; common defaults are in config.yaml.
# GENERATOR_MODEL=gpt-4.1-mini
# JUDGE_MODEL=gpt-4.1-nano
# EMBEDDING_DEVICE=cpu
